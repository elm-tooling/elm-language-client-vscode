{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "lib": ["ES2022"],
    "sourceMap": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "composite": true,
    "baseUrl": ".",
    "downlevelIteration": true,
    "types": ["mocha"]
  },
  "exclude": ["node_modules"]
}
